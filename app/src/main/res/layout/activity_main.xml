<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#101119">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MUSIC CUT" android:textSize="30sp" android:layout_marginBottom="10dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Sesini seç. İstediğin anı sakla." android:textSize="16sp" android:layout_marginBottom="10dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Çevrimdışı • Reklamsız • Sana ait" android:textSize="12sp" android:layout_marginBottom="10dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="16dp" android:background="@drawable/panel"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="01 / DOSYA" android:textSize="12sp" android:layout_marginBottom="10dp"/><Button android:id="@+id/pickButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="＋  Ses dosyası seç" android:textAllCaps="false" android:enabled="true"/><TextView android:id="@+id/fileName" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Henüz dosya seçilmedi" android:layout_marginTop="12dp" android:textSize="16sp"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="16dp" android:background="@drawable/panel"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="02 / ARALIĞI DÜZENLE" android:textSize="12sp" android:layout_marginBottom="10dp"/><TextView android:id="@+id/startLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginTop="12dp"/><SeekBar android:id="@+id/startSeek" android:layout_width="match_parent" android:layout_height="48dp" android:enabled="false" android:contentDescription="Başlangıç zamanı"/><TextView android:id="@+id/endLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginTop="12dp"/><SeekBar android:id="@+id/endSeek" android:layout_width="match_parent" android:layout_height="48dp" android:enabled="false" android:contentDescription="Bitiş zamanı"/><TextView android:id="@+id/lengthLabel" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="16sp" android:layout_marginTop="12dp"/><Button android:id="@+id/timeButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Hassas zaman gir" android:textAllCaps="false" android:enabled="false"/><Button android:id="@+id/resetButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Tümünü seç" android:textAllCaps="false" android:enabled="false"/><Button android:id="@+id/previewButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/preview" android:textAllCaps="false" android:enabled="false"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:layout_marginTop="16dp" android:background="@drawable/panel"><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="03 / DIŞA AKTAR" android:textSize="12sp" android:layout_marginBottom="10dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Dosya adı" android:textSize="14sp" android:layout_marginBottom="10dp"/><EditText android:id="@+id/outputName" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:hint="Kaydın adı" android:inputType="text" android:singleLine="true" android:maxLength="100"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Ses kalitesi · AAC / M4A" android:textSize="14sp" android:layout_marginBottom="10dp"/><Spinner android:id="@+id/quality" android:layout_width="match_parent" android:layout_height="48dp" android:contentDescription="Çıkış ses kalitesi"/><Button android:id="@+id/saveButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Kes ve kaydet" android:textAllCaps="false" android:enabled="false"/><ProgressBar android:id="@+id/progressBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:max="100" android:visibility="gone"/><Button android:id="@+id/cancelButton" android:layout_width="match_parent" android:layout_height="48dp" android:text="İptal et" android:visibility="gone"/><TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:layout_marginTop="12dp"/><Button android:id="@+id/openButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Kaydı dinle" android:textAllCaps="false" android:enabled="false"/><Button android:id="@+id/shareButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="Kaydı paylaş" android:textAllCaps="false" android:enabled="false"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Kayıt konumu: Music/MuzikKirp" android:textSize="12sp" android:layout_marginBottom="10dp"/></LinearLayout>
